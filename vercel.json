{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 15,
            "excludeFiles": "{tests/**,docs/**,node_modules/**,storage/logs/**}"
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "src": "/(favicon\\.ico|favicon\\.svg|apple-touch-icon\\.png|robots\\.txt)", "dest": "/public/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "Chirper",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_CONFIG_CACHE": "/tmp/config.php",
        "APP_EVENTS_CACHE": "/tmp/events.php",
        "APP_PACKAGES_CACHE": "/tmp/packages.php",
        "APP_ROUTES_CACHE": "/tmp/routes.php",
        "APP_SERVICES_CACHE": "/tmp/services.php",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "pgsql",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync",
        "MAIL_MAILER": "log",
        "CHIRPER_DEMO_RESET": "false"
    }
}
