{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/livewire-starter-kit",
  "type": "project",
  "description": "The official Laravel starter kit for Livewire.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/chisel": "^0.1.0",
    "laravel/framework": "^13.17",
    "laravel/tinker": "^3.0",
    "livewire/blaze": "^1.0",
    "livewire/flux": "^2.13.1",
    "livewire/livewire": "^4.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.27",
    "laravel/sail": "^1.53",
    "laravel/telescope": "^5.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9.3",
    "pestphp/pest": "^5.3",
    "pestphp/pest-plugin-browser": "^5.1",
    "pestphp/pest-plugin-drift": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "npm install",
      "npm run build"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan dev"
    ],
    "lint": [
      "pint --parallel"
    ],
    "lint:check": [
      "pint --parallel --test"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "@test"
    ],
    "types:check": [
      "phpstan analyse --memory-limit=1G"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@lint:check",
      "@types:check",
      "@test:arch",
      "@php artisan test"
    ],
    "test:browser": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan config:clear --ansi",
      "@php artisan test --testsuite=Browser"
    ],
    "test:arch": [
      "pest tests/Arch.php"
    ],
    "test:coverage": [
      "@php artisan config:clear --ansi",
      "@putenv XDEBUG_MODE=coverage",
      "@php artisan test --coverage --min=90"
    ],
    "test:mutate": [
      "Composer\\Config::disableProcessTimeout",
      "@php artisan config:clear --ansi",
      "@putenv XDEBUG_MODE=coverage",
      "pest --mutate --no-cache --min=96 --class=App\\\\Http\\\\Controllers\\\\ChirpController,App\\\\Http\\\\Requests,App\\\\Policies,App\\\\Models\\\\Chirp,App\\\\Providers\\\\AppServiceProvider,App\\\\Support,App\\\\Rules"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ],
    "deploy": [
      "Composer\\Config::disableProcessTimeout",
      "npm run build",
      "vercel deploy --prod --yes"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ],
      "installer": {
        "post-create-project": []
      }
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
